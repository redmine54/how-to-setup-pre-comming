{
  "name": "my-node-app",
  "version": "1.0.0",
  "scripts": {
    "prepare": "husky",
    "fetch-common-lint-rules": "bash ./fetch_common_lint_rules.sh"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.5",
    "audit-ci": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --config .eslintrc.common.cjs",
      "prettier --write --config .prettierrc.common.json"
    ]
  }
}
